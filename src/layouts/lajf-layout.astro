---
/**
 * Layout "Kinetic Aurora" — wspólny dla homepage i pillarów lajf.eu.
 * Daje: <head>/SEO/JSON-LD, tło (aurora), nawigację, stopkę, skrypty interakcji.
 * Treść strony idzie do <slot />. Kolor akcentu sterowany propem `accent`.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/lajf-kinetic.css';
import { siteConfig } from '../../site.config';
import Whatsapp from '../components/whatsapp.astro';
import AnalyticsGa4 from '../components/analytics-ga4.astro';
import CookieConsent from '../components/cookie-consent.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  accent?: string;
  /** Dodatkowy JSON-LD strony (np. Service z ofertą) — dokładany obok Organization. */
  schema?: Record<string, unknown>;
}

const { title, description, accent = '#5b8cff', schema } = Astro.props;
const { brandName, company } = siteConfig;
const telHref = `tel:${company.phone.replace(/\s/g, '')}`;
const year = new Date().getFullYear();

const siteUrl = Astro.site ?? new URL('https://lajf.eu');
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL('/images/og-default.jpg', siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brandName,
  legalName: company.legalName,
  url: siteUrl.href,
  email: company.email,
  telephone: company.phone,
  address: company.address,
  ...(company.taxId ? { vatID: `PL${company.taxId.replace(/\D/g, '')}`, taxID: company.taxId } : {}),
  ...(company.krs ? { identifier: `KRS ${company.krs}` } : {}),
  description,
  slogan: 'Cyfrowa opieka nad firmą',
  knowsAbout: [
    'audyt cyfrowy',
    'strony internetowe',
    'analityka internetowa',
    'bezpieczeństwo techniczne stron',
    'ochrona danych na stronie internetowej',
    'automatyzacja procesów',
    'Google Workspace',
    'oprogramowanie na zamówienie',
  ],
};
---

<!doctype html>
<html lang="pl" style={`--acc:${accent}`}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#070510" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={brandName} />
<meta property="og:locale" content="pl_PL" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
<ClientRouter />
  <AnalyticsGa4 />
</head>
<body>
<div class="bg"></div>
<div class="mesh"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>
<div class="grain"></div><div class="vig"></div><div class="spot" id="spot"></div>
<div class="prog" id="prog"></div>

<nav><div class="wrap nav-in">
  <a class="logo" href="/" aria-label={brandName}>{brandName}<b><svg class="logo-puls" viewBox="45 36 50 33" aria-hidden="true"><path d="M50 54 h5 l5 -14 l6.5 25 l5 -11 h4" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="86" cy="54" r="5.5" fill="currentColor"/></svg></b></a>
  <div class="nav-links"><a href="/audyt-placowki-medycznej/">Audyt cyfrowy</a><a href="/strony-www/">Strony WWW</a><a href="/rodo-i-cyber/">Bezpieczeństwo i dane</a><a href="/oprogramowanie/">Oprogramowanie</a><a href="/#realizacje">Realizacje</a><a href="/#o-mnie">O mnie</a></div>
  <div class="nav-actions">
    <a class="nav-tel" href={telHref} aria-label={`Zadzwoń: ${company.phone}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      <span>{company.phone}</span>
    </a>
    <a href="/#kontakt" class="btn btn-primary magnetic nav-cta" style="padding:11px 20px">Konsultacja</a>
    <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="nav-mobile" aria-label="Otwórz menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</div>
<div class="nav-mobile" id="nav-mobile" hidden>
  <a class="nav-mobile-tel" href={telHref}>Zadzwoń: {company.phone}</a>
  <a href="/audyt-placowki-medycznej/">Audyt cyfrowy placówki</a>
  <a href="/strony-www/">Strony WWW</a>
  <a href="/rodo-i-cyber/">Bezpieczeństwo i dane</a>
  <a href="/oprogramowanie/">Oprogramowanie</a>
  <a href="/muzyka/">Muzyka</a>
  <a href="/#realizacje">Realizacje</a>
  <a href="/#o-mnie">O mnie</a>
  <a class="nav-mobile-cta" href="/#kontakt">Napisz do nas</a>
</div></nav>

<slot />

<footer><div class="wrap">
  <div class="foot-top">
    <div class="foot-brand">
      <span class="logo">{brandName}<b><svg class="logo-puls" viewBox="45 36 50 33" aria-hidden="true"><path d="M50 54 h5 l5 -14 l6.5 25 l5 -11 h4" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="86" cy="54" r="5.5" fill="currentColor"/></svg></b></span>
      <p>Cyfrowa opieka nad firmą. Audyt, wdrożenie i stała opieka — strona, analityka, bezpieczeństwo i automatyzacje, prowadzone przez jedną osobę odpowiedzialną za całość.</p>
      <div class="foot-contact">
        <a href={`mailto:${company.email}`}>{company.email}</a>
        <a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a>
        <span>Jaworzno, PL</span>
      </div>
    </div>
    <div class="foot-cols">
      <div class="foot-col"><h4>Usługi</h4><a href="/audyt-placowki-medycznej/">Audyt Cyfrowy</a><a href="/strony-www/">Strony WWW</a><a href="/rodo-i-cyber/">Bezpieczeństwo i dane</a><a href="/oprogramowanie/">Oprogramowanie</a><a href="/muzyka/">Muzyka</a></div>
      <div class="foot-col"><h4>Firma</h4><a href="/#realizacje">Realizacje</a><a href="/#o-mnie">O mnie</a><a href="/#kontakt">Kontakt</a></div>
      <div class="foot-col"><h4>Informacje</h4><a href="/polityka-prywatnosci/">Polityka prywatności</a><a href="/regulamin/">Regulamin</a><span>RODO · WCAG · hosting EU</span></div>
    </div>
  </div>
  <div class="foot-bottom">
    <span>
      © {year} {company.legalName}{company.krs ? ` · KRS ${company.krs}` : ''}{company.taxId ? ` · NIP ${company.taxId}` : ''}{company.regon ? ` · REGON ${company.regon}` : ''}
    </span>
    <span>Hosting w UE · zgodne z RODO</span>
  </div>
</div></footer>

<script>
  // Inicjalizacja interakcji — odpalana też po każdym przejściu (View Transitions)
  //
  // ⛔ STAN TRZYMAMY W ZAKRESIE MODUŁU, NIE NA `window`. Skrypt jest pakowany raz
  // i przeżywa przejścia View Transitions, więc zwykłe zmienne wystarczą. Wcześniej
  // były tu `window.__lajfSpot`, `window.__lajfProg` i `window.__lajfGlobals`, czyli
  // właściwości, których typ `Window` nie zna — stąd błędy ts(2339). Zamiast je
  // deklarować, prościej ich nie tworzyć.
  let spot: HTMLElement | null = null;
  let prog: HTMLElement | null = null;

  // Znaczniki „już podpięte" zamiast doklejania pól do elementów DOM (`el.__mag`).
  // WeakSet nie trzyma elementów przy życiu, więc usunięty węzeł zwalnia pamięć sam.
  const zPrzyciaganiem = new WeakSet<Element>();
  const zPochyleniem = new WeakSet<Element>();
  const zObsluga = new WeakSet<Element>();

  function lajfInit(){
    spot=document.getElementById('spot');
    prog=document.getElementById('prog');
    if('IntersectionObserver' in window){
      const io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:.14});
      document.querySelectorAll('.reveal:not(.in)').forEach(function(el){io.observe(el);});
    } else { document.querySelectorAll('.reveal').forEach(function(el){el.classList.add('in');}); }

    // Generyk przy querySelectorAll daje HTMLElement zamiast Element — dzięki temu
    // `.style` istnieje, a zdarzenie wskaźnika ma typ PointerEvent z clientX/clientY.
    document.querySelectorAll<HTMLElement>('.magnetic').forEach(function(b){
      if(zPrzyciaganiem.has(b)) return; zPrzyciaganiem.add(b);
      let r: DOMRect | null = null;
      b.addEventListener('pointerenter',function(){r=b.getBoundingClientRect();});
      b.addEventListener('pointermove',function(e){if(!r)r=b.getBoundingClientRect();const x=e.clientX-r.left-r.width/2;const y=e.clientY-r.top-r.height/2;b.style.transform='translate('+x*.25+'px,'+y*.35+'px)';});
      b.addEventListener('pointerleave',function(){b.style.transform='';r=null;});
    });
    document.querySelectorAll<HTMLElement>('.tilt').forEach(function(el){
      if(zPochyleniem.has(el)) return; zPochyleniem.add(el);
      let r: DOMRect | null = null;
      el.addEventListener('pointerenter',function(){r=el.getBoundingClientRect();});
      el.addEventListener('pointermove',function(e){if(!r)r=el.getBoundingClientRect();const px=(e.clientX-r.left)/r.width-.5;const py=(e.clientY-r.top)/r.height-.5;el.style.transform='perspective(800px) rotateY('+px*7+'deg) rotateX('+(-py*7)+'deg) translateY(-4px)';});
      el.addEventListener('pointerleave',function(){el.style.transform='';r=null;});
    });
    const przelacznik=document.getElementById('nav-toggle');
    const panel=document.getElementById('nav-mobile');
    if(przelacznik&&panel&&!przelacznik.dataset.bound){
      przelacznik.dataset.bound='1';
      const zamknij=function(){panel.hidden=true;przelacznik.setAttribute('aria-expanded','false');przelacznik.setAttribute('aria-label','Otwórz menu');przelacznik.classList.remove('open');};
      przelacznik.addEventListener('click',function(){
        if(przelacznik.getAttribute('aria-expanded')==='true'){zamknij();return;}
        panel.hidden=false;przelacznik.setAttribute('aria-expanded','true');przelacznik.setAttribute('aria-label','Zamknij menu');przelacznik.classList.add('open');
      });
      // Klik w link ma zamknąć panel — przy kotwicach (#kontakt) strona się nie przeładowuje.
      panel.addEventListener('click',function(e){if(e.target instanceof Element&&e.target.closest('a')) zamknij();});
      document.addEventListener('keydown',function(e){if(e.key==='Escape') zamknij();});
    }
    document.querySelectorAll<HTMLFormElement>('form[data-engine-form]').forEach(function(form){
      if(zObsluga.has(form)) return; zObsluga.add(form);
      form.addEventListener('submit',async function(event){
        event.preventDefault();
        const btn=form.querySelector<HTMLButtonElement>('button[type=submit]');const original=btn?btn.textContent:'';
        if(btn){btn.setAttribute('disabled','true');btn.textContent='Wysyłam…';}
        const payload: Record<string, unknown>=Object.fromEntries(new FormData(form).entries());payload.form=form.getAttribute('name')||'kontakt';
        try{
          const res=await fetch('/api/contact',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});
          // Kształt odpowiedzi błędu z /api/contact: { error: { code, message } }.
          const data=await res.json().catch(function(){return {};}) as { error?: { message?: string } };
          if(!res.ok) throw new Error(data.error?.message||'Błąd wysyłki.');
          form.innerHTML='<p class="form-status form-status--ok">Dzięki! Odezwę się najszybciej, jak się da.</p>';
          // Lead liczymy dopiero po potwierdzeniu z serwera. Analityka nasłuchuje
          // tego zdarzenia — layout nie musi wiedzieć, czy stoi na niej GA4 czy GTM.
          document.dispatchEvent(new CustomEvent('lajf:lead',{detail:{metoda:form.getAttribute('data-lead-method')||'formularz'}}));
        }catch(err){
          if(btn){btn.removeAttribute('disabled');btn.textContent=original;}
          let note=form.querySelector<HTMLElement>('.form-status--err');
          if(!note){note=document.createElement('p');note.className='form-status form-status--err';form.appendChild(note);}
          note.textContent=err instanceof Error&&err.message?err.message:'Nie udało się wysłać.';
        }
      });
    });
  }

  // Nasłuchy globalne podpinamy raz — moduł wykonuje się jednokrotnie, więc nie
  // trzeba już pilnować tego flagą na `window`.
  // Kotwice wewnątrz strony. Bez tego klik w „Zamów audyt" (#zamow) czy
  // „Zamów bezpłatną konsultację" (#kontakt) nie robi nic: router View Transitions
  // przejmuje kliknięcie w link, a że adres różni się tylko fragmentem, nie ma
  // dokąd nawigować i natywne przewinięcie do kotwicy nie następuje.
  addEventListener('click',function(e){
    const link=e.target instanceof Element?e.target.closest('a[href*="#"]'):null;
    if(!link) return;
    const href=link.getAttribute('href')||'';
    const pozycja=href.indexOf('#');
    const hash=href.slice(pozycja);
    if(hash.length<2) return;
    // Link z inną ścieżką prowadzi na inną stronę — zostawiamy go routerowi.
    const sciezka=href.slice(0,pozycja);
    if(sciezka&&sciezka!==location.pathname&&sciezka+'/'!==location.pathname) return;
    let cel: Element | null=null;
    try{ cel=document.querySelector(hash); }catch{ return; }
    if(!cel) return;
    e.preventDefault();
    // Skok pomija naturalne wejście sekcji w kadr, więc animacja odsłaniania
    // mogłaby jej nie odpalić i użytkownik wylądowałby na przezroczystej treści.
    // Odsłaniamy docelową sekcję z góry — obserwator i tak pomija to, co ma już klasę.
    if(cel.classList.contains('reveal')) cel.classList.add('in');
    cel.querySelectorAll('.reveal:not(.in)').forEach(function(el){el.classList.add('in');});
    // Przewijamy natychmiast, nie płynnie. Na tej stronie płynne przewijanie
    // nie rusza z miejsca (sprawdzone: scrollTo z behavior 'smooth' po 2,5 s
    // wciąż na zerze, przy kolejnej próbie zawiesił się renderer — podejrzenie
    // pada na animowane rozmycia w tle). Kotwica ma działać, nie ładnie wyglądać.
    cel.scrollIntoView({behavior:'instant',block:'start'});
    history.pushState(null,'',hash);
  });
  addEventListener('pointermove',function(e){if(spot){spot.style.left=e.clientX+'px';spot.style.top=e.clientY+'px';}});
  addEventListener('scroll',function(){if(prog){const h=document.documentElement;prog.style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight)*100)+'%';}});
  document.addEventListener('astro:page-load', lajfInit);
</script>
<CookieConsent locale="pl" />
<Whatsapp />
</body>
</html>
