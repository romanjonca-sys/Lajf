---
/**
 * Landing produktu wejściowego: Audyt Cyfrowy Placówki Medycznej.
 * Strona, którą Roman podaje przez telefon — ma odpowiedzieć na sześć pytań
 * (kto, co sprawdza, komu ufać, co dostaję, ile kosztuje, co dalej) bez scrollowania w nieskończoność.
 *
 * Świadomie NIE używa `segment-landing.astro`: tamten komponent ma wbitą
 * kartę abonamentu 399 zł/mc razem z ceną w schema.org, a tu obowiązuje
 * jedna cena 1490 zł netto. Reszta (layout, klasy, formularz) jest wspólna.
 *
 * Treść siedmiu obszarów, dowodów i procesu jest w stałych poniżej, a nie
 * wpleciona w znaczniki. To wystarczy, żeby przyszły wariant „Audyt Cyfrowy
 * Firmy" powstał przez podmianę tych stałych — bez kopiowania układu strony.
 */
import LajfLayout from '../layouts/lajf-layout.astro';
import { siteConfig } from '../../site.config';

const title = 'Audyt Cyfrowy Placówki Medycznej — 1490 zł netto | Lajf';
const description =
  'Sprawdź, gdzie Twoja placówka traci pacjentów, czas i pieniądze. Strona, Google, analityka, bezpieczeństwo, dane, ścieżka pacjenta i automatyzacje w jednym audycie. Raport z priorytetami. 1490 zł netto.';

const telHref = `tel:${siteConfig.company.phone.replace(/\s/g, '')}`;

/** Siedem obszarów audytu. Numeracja jest częścią treści — porządkuje czytanie. */
const zakres = [
  {
    nr: '01',
    b: 'Strona WWW i technika',
    s: 'Czy strona jest szybka, czytelna na telefonie i prowadzi pacjenta do właściwego działania.',
    d: 'M3 5h18v11H3zM8 20h8M12 16v4',
  },
  {
    nr: '02',
    b: 'Widoczność w Google',
    s: 'Czy placówkę można znaleźć wtedy, kiedy pacjent rzeczywiście szuka pomocy.',
    d: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4',
  },
  {
    nr: '03',
    b: 'Analityka i konwersje',
    s: 'Czy wiesz, skąd przychodzą pacjenci i które działania naprawdę prowadzą do kontaktu.',
    d: 'M4 19V9M10 19V5M16 19v-7M22 19H2',
  },
  {
    nr: '04',
    b: 'Bezpieczeństwo techniczne',
    s: 'Konfiguracja strony, aktualność, nagłówki bezpieczeństwa, dostępy i kopie zapasowe.',
    d: 'M12 3l7 3v5c0 4.6-3.1 7.8-7 9-3.9-1.2-7-4.4-7-9V6l7-3zM9 12l2 2 4-4',
  },
  {
    nr: '05',
    b: 'Formularze, cookies i dane',
    s: 'Jakie dane zbiera strona, dokąd je wysyła i jakie narzędzia działają w tle.',
    d: 'M6 3h9l4 4v14H6zM15 3v4h4M9 13h6M9 17h4',
  },
  {
    nr: '06',
    b: 'Ścieżka pacjenta',
    s: 'Od wejścia na stronę do telefonu, formularza lub rejestracji. Sprawdzamy, gdzie pacjent może się zatrzymać albo zrezygnować.',
    d: 'M4 20s2-8 8-8 8 8 8 8M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',
  },
  {
    nr: '07',
    b: 'Automatyzacje',
    s: 'Szukamy powtarzalnych czynności, które można uprościć lub przekazać technologii.',
    d: 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1',
  },
];

/**
 * Przykładowe ustalenia do podglądu raportu. Ilustracja działania produktu —
 * nie opis żadnej konkretnej placówki. Zastrzeżenie stoi pod mockupem.
 */
const przykladoweUstalenia = [
  {
    waga: 'PILNE',
    klasa: 'pilne',
    tresc: 'Formularz przesyła dane do zewnętrznego narzędzia przed uzyskaniem wymaganej zgody.',
  },
  {
    waga: 'WAŻNE',
    klasa: 'wazne',
    tresc: 'Na urządzeniu mobilnym droga od strony głównej do rejestracji wymaga zbyt wielu kroków.',
  },
  {
    waga: 'SZANSA',
    klasa: 'szansa',
    tresc: 'Powtarzalne przypomnienia i obsługę części zapytań można zautomatyzować.',
  },
];

/** Cztery pytania, na które odpowiada raport — hierarchia od diagnozy do decyzji. */
const czteryPytania = [
  { nr: '1', q: 'Co jest nie tak?', s: 'Konkretne znalezisko, opisane bez żargonu.' },
  { nr: '2', q: 'Dlaczego ma to znaczenie?', s: 'Co z tego wynika dla placówki i dla pacjenta.' },
  { nr: '3', q: 'Co zrobić?', s: 'Zalecenie, które da się wykonać — także bez nas.' },
  { nr: '4', q: 'Co zrobić najpierw?', s: 'Kolejność. Bo nie wszystko naraz i nie wszystko od razu.' },
];

const otrzymujesz = [
  { b: 'Raport PDF', s: 'Komplet ustaleń na piśmie, opisany po ludzku. Zostaje u Ciebie i możesz go pokazać komukolwiek.' },
  { b: 'Podsumowanie najważniejszych ustaleń', s: 'Skrót na początku raportu: co znaleźliśmy, zanim wejdziesz w szczegóły.' },
  { b: 'Priorytety problemów', s: 'Co naprawić najpierw, co potem, a co może spokojnie poczekać.' },
  { b: 'Konkretne rekomendacje', s: 'Przy każdym znalezisku napisane, co z nim zrobić. Bez „należy rozważyć optymalizację".' },
  { b: 'Roadmapa dalszych działań', s: 'Kolejność kroków po audycie, żebyś wiedział, w co się pakujesz, zanim się w to spakujesz.' },
  { b: 'Omówienie wyników', s: 'Rozmowa, na której przechodzimy przez raport i odpowiadam na pytania. Raport bez omówienia zwykle ląduje w szufladzie.' },
];

/** Dowody kompetencji — wyłącznie rzeczy, które naprawdę powstały i działają. */
const dowody = [
  { b: 'Moje RODO', s: 'Działający system zgodności dla placówek medycznych.', href: 'https://moje-rodo.pl' },
  { b: 'Panel Lajf', s: 'Własny system sprzedaży i obsługi klientów.', href: null },
  { b: 'Social OS', s: 'Własne narzędzie do zarządzania komunikacją marek.', href: null },
  { b: 'Realizacje', s: 'Działające serwisy, które można samemu sprawdzić.', href: '/#realizacje' },
];

const wspolpraca = [
  { n: '01', h: 'Pre-audyt', p: 'Bezpłatne sprawdzenie z zewnątrz i rozmowa. Mówię wprost, czy widzę coś, co warto naprawiać.' },
  { n: '02', h: 'Audyt Cyfrowy', p: 'Siedem obszarów, raport z priorytetami i rekomendacjami, omówienie wyników.' },
  { n: '03', h: 'Wdrożenie', p: 'Naprawiamy to, co wyszło w audycie. Zakres wynika z raportu, nie z gotowego cennika.' },
  { n: '04', h: 'Cyfrowa Opieka', p: 'Stała opieka nad cyfrową stroną placówki: pilnujemy, mierzymy, poprawiamy.' },
];

const faq = [
  {
    q: 'Czy to jest audyt RODO?',
    a: 'Nie. Sprawdzamy techniczną stronę ochrony danych: co zbierają Twoje formularze, dokąd to wędruje, jakie skrypty działają w tle i jak ustawione są cookies. To nie jest opinia prawna ani pełny audyt zgodności — tym zajmuje się nasza wyspecjalizowana marka moje-rodo i jeśli okaże się potrzebna, powiem to wprost w raporcie.',
  },
  {
    q: 'Czy to test bezpieczeństwa typu włamanie?',
    a: 'Nie. Robimy przegląd konfiguracji: certyfikat, nagłówki, aktualność oprogramowania, dostępy, kopie zapasowe. Nie próbujemy się włamywać do Twoich systemów i nie testujemy ich odporności na atak. To osobna usługa, która wymaga osobnej umowy i zgody na piśmie.',
  },
  {
    q: 'Mam informatyka albo agencję. Po co mi audyt?',
    a: 'Audyt nie jest przeciwko nim. Jest spojrzeniem z zewnątrz na całość — bo informatyk zwykle odpowiada za serwer, agencja za reklamy, a nikt za to, czy to wszystko razem prowadzi pacjenta do rejestracji. Raport możesz przekazać swoim ludziom i zlecić naprawę im. Wielu klientów tak robi.',
  },
  {
    q: 'Czy po audycie muszę zlecić wam wdrożenie?',
    a: 'Nie. Raport jest Twój i możesz z nim zrobić, co chcesz — wdrożyć samodzielnie, zlecić komu innemu albo odłożyć. Nie ma tu żadnego zobowiązania, a rekomendacje piszemy tak, żeby dało się je wykonać bez nas.',
  },
  {
    q: 'Czym różni się bezpłatny pre-audyt od płatnego audytu?',
    a: 'Pre-audyt to szybkie spojrzenie z zewnątrz i rozmowa — sprawdzam, czy w ogóle jest o czym rozmawiać. Płatny audyt to przejście przez siedem obszarów, raport na piśmie z priorytetami i rekomendacjami oraz omówienie wyników. Pre-audyt jest bezpłatny i do niczego nie zobowiązuje.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: 'Audyt Cyfrowy Placówki Medycznej',
      serviceType: 'Audyt cyfrowy',
      description,
      provider: { '@type': 'Organization', name: 'Lajf', url: 'https://lajf.eu/' },
      areaServed: 'PL',
      audience: { '@type': 'BusinessAudience', name: 'Prywatne placówki medyczne i gabinety' },
      offers: {
        '@type': 'Offer',
        price: 1490,
        priceCurrency: 'PLN',
        valueAddedTaxIncluded: false,
        availability: 'https://schema.org/InStock',
        url: 'https://lajf.eu/audyt-placowki-medycznej/',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<LajfLayout title={title} description={description} schema={schema}>
  <header class="phero"><div class="wrap pin">
    <span class="label">Dla prywatnych placówek medycznych i gabinetów</span>
    <h1>Audyt Cyfrowy <span class="hl">Placówki Medycznej</span></h1>
    <p class="lead lead-claim">Sprawdź, gdzie Twoja placówka traci pacjentów, czas i pieniądze.</p>
    <p class="lead lead-opis">
      W jednym audycie sprawdzamy stronę WWW, widoczność w Google, analitykę, bezpieczeństwo,
      formularze i dane, ścieżkę pacjenta oraz procesy, które można uprościć lub zautomatyzować.
    </p>
    <p class="lead lead-opis">
      Dostajesz konkretny raport: co działa, co wymaga poprawy i co warto zrobić najpierw.
    </p>
    <div class="center hero-akcja">
      <a href="#zamow" class="btn btn-primary magnetic">Zamów audyt — 1 490 zł netto</a>
      <p class="hero-drugi">
        Zanim zdecydujesz, możemy zrobić <a href="#zamow">bezpłatny pre-audyt</a>.
        Albo zadzwoń: <a href={telHref}>{siteConfig.company.phone}</a>.
      </p>
    </div>
  </div></header>

  <section id="co-sprawdzamy"><div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Zakres</span>
      <h2>Co sprawdzamy</h2>
      <p>Siedem obszarów, które razem decydują o tym, czy pacjent trafia do Twojej rejestracji — czy do kogoś innego.</p>
    </div>
    <ul class="zakres">
      {zakres.map((item) => (
        <li class="reveal">
          <span class="zakres-nr">{item.nr}</span>
          <span class="zakres-ikona"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={item.d} /></svg></span>
          <div class="zakres-txt"><b>{item.b}</b><span>{item.s}</span></div>
        </li>
      ))}
    </ul>
    <p class="zastrzezenie reveal">
      Audyt <strong>nie jest</strong> pełnym audytem prawnym RODO ani testem penetracyjnym.
      Jeśli któryś z nich okaże się potrzebny, napiszę to w raporcie wprost.
    </p>
  </div></section>

  <section id="wynik"><div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Podgląd produktu</span>
      <h2>Co zobaczysz po audycie</h2>
      <p>Nie dostajesz listy technicznych uwag. Dostajesz uporządkowane ustalenia — każde z wagą i z tym, co z nim zrobić.</p>
    </div>

    <div class="wynik-uklad">
      <div class="raport reveal">
        <div class="raport-pasek">
          <span class="raport-marka">Lajf<b>.</b></span>
          <span class="raport-tytul">Audyt Cyfrowy — fragment raportu</span>
        </div>
        <div class="raport-tresc">
          {przykladoweUstalenia.map((u) => (
            <div class="ustalenie">
              <span class={`waga ${u.klasa}`}>{u.waga}</span>
              <p>{u.tresc}</p>
            </div>
          ))}
        </div>
        <p class="raport-stopka">Przykładowe ustalenia — ilustracja układu raportu, nie opis konkretnej placówki.</p>
      </div>

      <div class="pytania-lista reveal">
        <p class="pytania-wstep">Przy każdym ustaleniu odpowiadamy na cztery pytania:</p>
        {czteryPytania.map((p) => (
          <div class="pytanie">
            <span class="pytanie-nr">{p.nr}</span>
            <div><b>{p.q}</b><span>{p.s}</span></div>
          </div>
        ))}
        <a href="#zamow" class="btn btn-primary magnetic pytania-cta">Zamów audyt →</a>
      </div>
    </div>
  </div></section>

  <section id="co-dostajesz"><div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Zakres dostawy</span>
      <h2>Co dostajesz</h2>
      <p>Dokument, z którym możesz pójść do kogokolwiek — także do swojego informatyka.</p>
    </div>
    <ul class="dostawa">
      {otrzymujesz.map((item) => (
        <li class="reveal"><b>{item.b}</b><span>{item.s}</span></li>
      ))}
    </ul>
  </div></section>

  <section id="dlaczego"><div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Kto to robi</span>
      <h2>Nie tylko doradzamy. Sami budujemy i prowadzimy systemy cyfrowe.</h2>
      <p>Audyt wykonuje ktoś, kto na co dzień projektuje strony, systemy, automatyzacje i procesy — i odpowiada za ich działanie.</p>
    </div>
    <ul class="dowody">
      {dowody.map((item) => (
        <li class="reveal">
          <b>{item.href ? <a href={item.href}>{item.b} →</a> : item.b}</b>
          <span>{item.s}</span>
        </li>
      ))}
    </ul>
  </div></section>

  <section id="wspolpraca"><div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Jak to idzie</span>
      <h2>Cztery etapy, jedna ścieżka</h2>
      <p><strong>Możesz zatrzymać się po każdym etapie.</strong> Każdy kolejny jest Twoją decyzją, nie automatem.</p>
    </div>
    <ol class="sciezka">
      {wspolpraca.map((item) => (
        <li class="reveal">
          <span class="sciezka-nr">{item.n}</span>
          <div class="sciezka-txt"><b>{item.h}</b><span>{item.p}</span></div>
        </li>
      ))}
    </ol>
  </div></section>

  <section id="cena" data-audit-price><div class="wrap">
    <div class="cennik reveal">
      <div class="cennik-lewa">
        <span class="label">Cena</span>
        <h2>Audyt Cyfrowy<br />Placówki Medycznej</h2>
        <div class="cennik-kwota"><strong>1 490 zł</strong><span>netto</span></div>
        <p class="cennik-nota">Jedna cena, bez pakietów. Pre-audyt przed nim jest bezpłatny.</p>
        <a href="#zamow" class="btn btn-primary magnetic">Zamów audyt →</a>
      </div>
      <ul class="cennik-lista">
        <li>Siedem obszarów sprawdzonych po kolei</li>
        <li>Raport PDF z priorytetami i rekomendacjami</li>
        <li>Odpowiedź na cztery pytania przy każdym ustaleniu</li>
        <li>Roadmapa dalszych działań</li>
        <li>Omówienie wyników na rozmowie</li>
        <li>Bez zobowiązania do dalszej współpracy</li>
      </ul>
    </div>
  </div></section>

  <section id="pytania"><div class="wrap">
    <div class="sec-head reveal"><span class="label">Pytania</span><h2>Najczęstsze pytania</h2></div>
    <div class="lfaq reveal">
      {faq.map((item) => (
        <details><summary>{item.q}</summary><p>{item.a}</p></details>
      ))}
    </div>
  </div></section>

  <section id="zamow"><div class="wrap">
    <div class="formcard reveal">
      <h2>Zacznijmy od bezpłatnego pre-audytu</h2>
      <p class="sub">Podaj stronę placówki. Najpierw sprawdzimy ją z zewnątrz i skontaktujemy się z Tobą. Jeśli pełny audyt nie będzie miał sensu — powiemy to wprost.</p>
      <form name="audyt" data-engine-form data-lead-method="formularz-audyt">
        <div class="frow">
          <div class="field"><label for="a-placowka">Nazwa placówki</label><input id="a-placowka" name="placowka" placeholder="np. Przychodnia Zdrowie" required /></div>
          <div class="field"><label for="a-www">Adres WWW</label><input id="a-www" name="www" placeholder="np. przychodnia-zdrowie.pl" /></div>
        </div>
        <div class="frow">
          <div class="field"><label for="a-telefon">Telefon</label><input id="a-telefon" name="telefon" type="tel" placeholder="np. 600 100 200" /></div>
          <div class="field"><label for="a-email">E-mail</label><input id="a-email" name="email" type="email" placeholder="kontakt@placowka.pl" required /></div>
        </div>
        <div class="hp" aria-hidden="true"><label for="a-gotcha">Nie wypełniaj tego pola</label><input id="a-gotcha" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
        <button type="submit" class="btn btn-primary magnetic" style="width:100%;justify-content:center">Sprawdź moją placówkę →</button>
        <p class="qnote">Bez zobowiązań. Pełny Audyt Cyfrowy kosztuje 1 490 zł netto.</p>
      </form>
    </div>
  </div></section>
</LajfLayout>

<style>
  /* ——— Hero ——— */
  /* Claim niesie obietnicę, opis ją rozwija — stąd różnica wielkości i koloru. */
  .lead-claim {
    font-family: 'Space Grotesk Variable', 'Space Grotesk', sans-serif;
    font-size: clamp(19px, 2.3vw, 25px);
    font-weight: 600;
    color: var(--txt);
    margin-bottom: 18px;
  }
  .lead-opis { font-size: 16px; margin-bottom: 10px; }
  .hero-akcja { margin-top: 30px; }
  /* Pre-audyt obniża barierę wejścia, więc jest zdaniem, nie drugim przyciskiem. */
  .hero-drugi { margin-top: 16px; font-size: 15px; color: var(--mut); }
  .hero-drugi a { color: var(--acc); }

  /* ——— Siedem obszarów ——— */
  /* Poprzednio: cztery kolumny po 261 px, karty 310–336 px wysokie, bo tekst
     łamał się na siedem linii. Trzy szersze kolumny mieszczą opis w trzech
     wierszach i skracają sekcję o połowę bez zmiany estetyki. */
  .zakres { display: grid; gap: 14px; grid-template-columns: 1fr; list-style: none; padding: 0; }
  @media (min-width: 48rem) { .zakres { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 72rem) { .zakres { grid-template-columns: repeat(3, 1fr); } }
  .zakres li {
    position: relative;
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 14px;
    align-items: start;
    padding: 18px 18px 18px 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
  }
  .zakres-nr {
    position: absolute; top: 14px; right: 16px;
    font-family: 'Space Grotesk Variable', 'Space Grotesk', sans-serif;
    font-size: 13px; font-weight: 700; letter-spacing: .04em;
    color: color-mix(in srgb, var(--acc) 55%, transparent);
  }
  .zakres-ikona {
    width: 38px; height: 38px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    color: var(--acc);
    background: color-mix(in srgb, var(--acc) 13%, transparent);
    border: 1px solid color-mix(in srgb, var(--acc) 28%, transparent);
  }
  .zakres-ikona svg { width: 20px; height: 20px; display: block; }
  .zakres-txt b {
    display: block; margin-bottom: 4px; padding-right: 30px;
    font-family: 'Space Grotesk Variable', 'Space Grotesk', sans-serif;
    font-size: 16px; line-height: 1.3;
  }
  .zakres-txt span { color: var(--mut); font-size: 14px; line-height: 1.55; }

  .zastrzezenie {
    max-width: 680px; margin: 28px auto 0; text-align: center;
    color: var(--mut); font-size: 14.5px; line-height: 1.6;
  }
  .zastrzezenie strong { color: var(--txt); }

  /* ——— Podgląd raportu ——— */
