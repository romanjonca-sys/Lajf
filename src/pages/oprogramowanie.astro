---
import LajfLayout from '../layouts/lajf-layout.astro';
const title = 'Oprogramowanie na miarę — aplikacje, panele, płatności | Lajf';
const description =
  'Aplikacje webowe, panele i systemy z płatnościami i workflow — szyte na miarę firmy. Robiliśmy m.in. system dla szpitala. Next.js, Supabase, Paynow.';
---
<LajfLayout title={title} description={description} accent="#ff7a59">
  <header class="phero"><div class="wrap pin">
    <span class="label">Oprogramowanie na miarę</span>
    <h1>Gdy gotowiec nie wystarcza — <span class="hl">budujemy własne</span></h1>
    <p class="lead">Aplikacja, panel, system z płatnościami i przemyślanym obiegiem pracy. Projektujemy i wdrażamy oprogramowanie dopasowane do tego, jak naprawdę działa Twoja firma.</p>
    <div class="center"><a href="/#kontakt" class="btn btn-primary magnetic">Opowiedz o swoim pomyśle →</a></div>
  </div></header>

  <section><div class="wrap">
    <div class="sec-head reveal"><span class="label">Co robimy</span><h2>Od panelu po pełny system</h2></div>
    <ul class="feats">
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 8.5h18"/></svg></span><div class="ftxt"><b>Aplikacje webowe</b><span>Narzędzia i platformy szyte pod Twój proces — nie odwrotnie.</span></div></li>
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M10 9v11"/></svg></span><div class="ftxt"><b>Panele i dashboardy</b><span>Zarządzanie danymi, użytkownikami, treścią. Czytelnie i bezpiecznie.</span></div></li>
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg></span><div class="ftxt"><b>Płatności online</b><span>Integracja Paynow / Przelewy24 — realne płatności na produkcji, nie sandbox.</span></div></li>
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="6" height="6" rx="1.2"/><rect x="15" y="14" width="6" height="6" rx="1.2"/><path d="M9 7h3a3 3 0 0 1 3 3v6"/></svg></span><div class="ftxt"><b>Workflow i integracje</b><span>Automatyzacja obiegu, połączenia z systemami zewnętrznymi, API.</span></div></li>
    </ul>
  </div></section>

  <section><div class="wrap">
    <div class="sec-head reveal"><span class="label">Dowód</span><h2>Robiliśmy to dla realnych firm</h2><p>System zgodności RODO (moje-rodo), aplikacja medyczna dla szpitala, rejestr pacjentów pod doktorat — działające produkty z płatnościami i panelami, nie makiety.</p></div>
    <div class="work">
      <a class="w reveal" href="https://moje-rodo.pl" target="_blank" rel="noopener noreferrer"><span class="wic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.6-3.1 7.8-7 9-3.9-1.2-7-4.4-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></span><div class="wt">moje-rodo</div><div class="wc">SaaS zgodności RODO + płatności</div><span class="wtag">aplikacja · SaaS</span></a>
      <a class="w reveal" href="/#realizacje"><span class="wic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg></span><div class="wt">System dla szpitala</div><div class="wc">Aplikacja medyczna na zamówienie</div><span class="wtag">medical-tech</span></a>
      <a class="w reveal" href="/#realizacje"><span class="wic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></svg></span><div class="wt">Rejestr pacjentów</div><div class="wc">Panel + baza pod badania</div><span class="wtag">panel · baza</span></a>
    </div>
  </div></section>

  <section><div class="wrap">
    <div class="ctaband reveal">
      <h2>Masz pomysł na narzędzie albo system?</h2>
      <p>Opowiedz, co ma robić — odpiszę z konkretem i wstępnym kierunkiem w 24h.</p>
      <a href="/#kontakt" class="btn btn-primary magnetic">Porozmawiajmy →</a>
    </div>
  </div></section>
</LajfLayout>
