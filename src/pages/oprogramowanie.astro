---
/**
 * Systemy i narzędzia dla firm (dawniej „Oprogramowanie na miarę").
 *
 * Adres zostaje ten sam, bo jest w menu, w stopce i w indeksie Google. Zmienia się
 * obietnica: wcześniej strona mówiła „gdy gotowiec nie wystarcza, budujemy własne",
 * co dla klienta brzmi drogo i długo. Teraz mówi to, co jest realną przewagą — rdzeń
 * systemu jest już zbudowany, więc wdrożenie liczy się w tygodniach.
 *
 * Treść i układ są wspólne z `/en/systems/`, patrz `src/lib/systemy-tresc.ts`.
 */
import LajfLayout from '../layouts/lajf-layout.astro';
import SystemyStrona from '../components/systemy-strona.astro';
import { trescSystemow } from '../lib/systemy-tresc';

const t = trescSystemow('pl');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Systemy i narzędzia dla firm',
  provider: { '@type': 'Organization', name: 'Lajf' },
  areaServed: 'PL',
  description: t.description,
};
---

<LajfLayout title={t.title} description={t.description} accent="#ff7a59" schema={schema}>
  <SystemyStrona locale="pl" />
</LajfLayout>
