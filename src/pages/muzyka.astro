---
import LajfLayout from '../layouts/lajf-layout.astro';
const title = 'Dźwięk Dobry — pisanie piosenek i produkcja muzyczna | Lajf';
const description =
  'Piosenka na prezent, pisanie tekstów i produkcja muzyczna. Studio Dźwięk Dobry — od pomysłu i głosu do gotowego, dopracowanego utworu.';
---
<LajfLayout title={title} description={description} accent="#ff2f7e">
  <header class="phero"><div class="wrap pin">
    <span class="label">Muzyka i studio · Dźwięk Dobry</span>
    <h1>Twoja piosenka — <span class="hl">od pomysłu do gotowego utworu</span></h1>
    <p class="lead">Piosenka na prezent, tekst napisany na miarę, produkcja i aranżacja. Markę — i ważne chwile — buduje się też dźwiękiem.</p>
    <div class="center"><a href="/#kontakt" class="btn btn-primary magnetic">Zamów piosenkę →</a></div>
  </div></header>

  <section><div class="wrap">
    <div class="sec-head reveal"><span class="label">Co robimy</span><h2>Od słowa do nagrania</h2></div>
    <ul class="feats">
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M4 13h16M12 9v11"/><path d="M12 9c-1-3-5-3-4 0M12 9c1-3 5-3 4 0"/></svg></span><div class="ftxt"><b>Piosenka na prezent</b><span>Osobisty utwór na ślub, urodziny, rocznicę — historia zamieniona w piosenkę.</span></div></li>
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l4-1L19 8l-3-3L5 16z"/><path d="M14.5 6.5l3 3"/></svg></span><div class="ftxt"><b>Pisanie tekstów</b><span>Tekst napisany pod Twój pomysł, w wybranym stylu i nastroju.</span></div></li>
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21v-6M5 11V3M12 21v-8M12 9V3M19 21v-4M19 13V3"/><circle cx="5" cy="13" r="1.8"/><circle cx="12" cy="7" r="1.8"/><circle cx="19" cy="15" r="1.8"/></svg></span><div class="ftxt"><b>Produkcja i aranżacja</b><span>Od demo po dopracowane, gotowe do publikacji nagranie.</span></div></li>
      <li class="reveal"><span class="ficon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="18" r="2.4"/><circle cx="17" cy="16" r="2.4"/><path d="M8.4 18V7l11-2.2V16"/></svg></span><div class="ftxt"><b>Muzyka dla marek</b><span>Dżingiel, motyw, oprawa dźwiękowa — spójna z resztą Twojej obecności.</span></div></li>
    </ul>
  </div></section>

  <section><div class="wrap">
    <div class="ctaband reveal">
      <h2>Posłuchaj, co już powstało</h2>
      <p>Dźwięk Dobry to nasze studio pisania piosenek — zobacz realizacje i zamów własną.</p>
      <a href="https://dzwiekdobry.pl" target="_blank" rel="noopener noreferrer" class="btn btn-primary magnetic">Wejdź na dzwiekdobry.pl →</a>
    </div>
  </div></section>
</LajfLayout>
