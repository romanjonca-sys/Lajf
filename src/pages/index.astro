---
/**
 * Homepage lajf.eu — bespoke "2C+ Aurora" (kinetic dark).
 * Chrome (tło/nawigacja/stopka/skrypty) z lajf-layout. Tu: hero kinetyczny + sekcje + rotacja.
 */
import LajfLayout from '../layouts/lajf-layout.astro';
import IkonaSystemu from '../components/ikona-systemu.astro';
import { trescSystemow } from '../lib/systemy-tresc';

const title = 'Lajf — cyfrowa opieka nad firmą | audyt, technologia, automatyzacje';
const description =
  'Sprawdzamy, naprawiamy i rozwijamy cyfrowe funkcjonowanie firmy — od strony WWW i analityki po bezpieczeństwo i automatyzacje. Zaczynamy od Audytu Cyfrowego: 1490 zł netto.';

/**
 * Zajawka systemów: trzy pierwsze pozycje katalogu z `/oprogramowanie/`.
 * Bierzemy je z modułu, a nie przepisujemy, żeby strona główna i podstrona
 * nie zaczęły mówić dwóch różnych rzeczy o tym samym.
 */
const kafelkiSystemow = trescSystemow('pl').katalog.slice(0, 3);

const realizacje = [
  { t: 'Rejestr badania', c: 'Aplikacja do badania klinicznego', tag: 'app · medycyna', href: '/realizacje/rejestr-badania-klinicznego/', img: '/images/realizacje/rejestr-badania.jpg' },
  { t: 'moje-rodo', c: 'System zgodności RODO dla medycyny', tag: 'SaaS · RODO', href: 'https://moje-rodo.pl', img: '/images/realizacje/moje-rodo.jpg' },
  { t: 'Układ Komediowy', c: 'Strona + terminarz kabaretu', tag: 'web · rozrywka', href: 'https://ukladkomediowy.pl', img: '/images/realizacje/uklad.jpg' },
  { t: 'Krzysztof Stanio', c: 'Pracownia praktyk teatralnych', tag: 'web · kultura', href: 'https://krzysztofstanio.pl', img: '/images/realizacje/stanio.jpg' },
  { t: 'Grzegorz Kapołka', c: 'Strona bluesowego gitarzysty', tag: 'web · muzyk', href: 'https://kapolka-web.pages.dev', img: '/images/realizacje/kapolka.jpg' },
  { t: 'Dźwięk Dobry', c: 'Studio pisania piosenek', tag: 'web · muzyka', href: 'https://dzwiekdobry.pl', img: '/images/realizacje/dzwiek.jpg' },
  { t: 'Innova Biological', c: 'Strona B2B marki chemicznej', tag: 'web · B2B', href: 'https://innova-biological.pages.dev', img: '/images/realizacje/innova.jpg' },
  { t: 'Pan Kolektor', c: 'Serwis kolektorów słonecznych', tag: 'web · usługa', href: 'https://pankolektor.pl', img: '/images/realizacje/pankolektor.jpg' },
  { t: 'R&L Serwis', c: 'Sprzątanie domów, biur i gabinetów', tag: 'web · usługa', href: 'https://rlserwis.pl', img: '/images/realizacje/rlserwis.jpg' },
  { t: 'Klaudia Pałka', c: 'One-pager wokalistki', tag: 'web · artysta', href: 'https://klaudia-palka.pages.dev', img: '/images/realizacje/klaudia.jpg' },
];

/**
 * Opinie klientów.
 *
 * ZASADA: wpis trafia tu DOPIERO po pisemnej zgodzie klienta (mail „ok" w archiwum).
 * Gotowe teksty do autoryzacji leżą w mojezycie:
 * `plany/2026-08-12-lajf-eu-opinie-do-autoryzacji.md` — wysyłamy klientowi propozycję,
 * on potwierdza albo poprawia, dopiero wtedy wklejamy tutaj.
 *
 * Nie wstawiamy opinii wymyślonych „na chwilę". Od 1.01.2023 (dyrektywa Omnibus)
 * prezentowanie niezweryfikowanych opinii jest praktyką wprowadzającą w błąd —
 * a Lajf sprzedaje zgodność, więc to ostatnie miejsce na taki skrót.
 *
 * Pusta tablica = sekcja się nie renderuje. Wystarczy dopisać wpis i zrobić deploy.
 */
const opinie: { cytat: string; kto: string; rola: string }[] = [];
---

<LajfLayout title={title} description={description}>
  <header class="hero"><div class="wrap hero-in">
    <span class="label stagger d1">Technologia dla małych firm i placówek medycznych</span>
    <h1 class="stagger d2">Cyfrowa opieka <br />nad <span class="hl">Twoją firmą</span>.</h1>
    <p class="lead stagger d4">Sprawdzamy, naprawiamy i rozwijamy cyfrowe funkcjonowanie firmy — od strony WWW i analityki po bezpieczeństwo i automatyzacje. Jeden partner zamiast pięciu wykonawców.</p>
    <div class="hero-cta stagger d5">
      <a href="/audyt-placowki-medycznej/" class="btn btn-primary magnetic">Sprawdź swoją firmę →</a>
      <a href="#model" class="btn btn-ghost">Zobacz, jak możemy pomóc</a>
    </div>
    <div class="chips stagger d5"><a class="chip" href="/audyt-placowki-medycznej/">Audyty cyfrowe</a><a class="chip" href="/strony-www/">Technologia</a><a class="chip" href="#automatyzacje">Automatyzacje</a><a class="chip" href="#model">Opieka</a></div>
    <div class="proofbar stagger d5"><span><b>Audyt Cyfrowy</b> — 1490 zł netto</span><span><b>Jeden</b> partner</span><span><b>Konkretne</b> rekomendacje</span><span><b>Bez</b> zobowiązania do wdrożenia</span></div>
  </div>
  </header>

  <section id="model"><div class="wrap">
    <div class="sec-head reveal"><span class="label">Jak pracujemy</span><h2>Sprawdzamy → naprawiamy → pilnujemy</h2><p>Nie zaczynamy od przebudowy. Zaczynamy od sprawdzenia, co naprawdę działa, a co tylko wygląda, że działa.</p></div>
    <div class="steps">
      <div class="step reveal"><div class="n">01</div><h4>Diagnoza — sprawdzamy</h4><p>Audyt Cyfrowy: strona, Google, analityka, bezpieczeństwo techniczne, formularze i dane, ścieżka klienta oraz procesy, które da się zautomatyzować. Dostajesz raport z priorytetami i omówienie wyników.</p><a href="/audyt-placowki-medycznej/" class="pmore">Zobacz, co sprawdzamy →</a></div>
      <div class="step reveal"><div class="n">02</div><h4>Wdrożenie — naprawiamy i budujemy</h4><p>Strona WWW, analityka i pomiar, bezpieczeństwo techniczne, integracje, oprogramowanie na miarę i automatyzacje. Zakres wynika z audytu, nie z gotowego cennika.</p><a href="/strony-www/" class="pmore">Zobacz, co robimy →</a></div>
      <div class="step reveal"><div class="n">03</div><h4>Cyfrowa Opieka — pilnujemy i rozwijamy</h4><p>Stała opieka nad cyfrową stroną firmy: pilnujemy, mierzymy, poprawiamy. Żebyś nie wracał do tego samego punktu za rok.</p><a href="#kontakt" class="pmore">Porozmawiajmy →</a></div>
    </div>
    <div class="pillars" style="margin-top:34px">
      <a class="pillar tilt reveal" href="/strony-www/" style="--pc:rgba(91,140,255,.18);--pcb:#5b8cff"><div class="iconbox"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18"/></svg></div><h3>Strony WWW</h3><p>Strona z Twoją treścią, zoptymalizowana pod Google, z firmowymi mailami i Wizytówką.</p><span class="pmore">Zobacz pakiety →</span></a>
      <a class="pillar tilt reveal" href="/rodo-i-cyber/" style="--pc:rgba(43,212,168,.18);--pcb:#2bd4a8"><div class="iconbox"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.6-3.1 7.8-7 9-3.9-1.2-7-4.4-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg></div><h3>Bezpieczeństwo i dane</h3><p>Certyfikaty, nagłówki, formularze i skrypty. Techniczna strona ochrony danych na stronie firmy.</p><span class="pmore">Dla gabinetu →</span></a>
      <a class="pillar tilt reveal" href="/oprogramowanie/" style="--pc:rgba(255,122,89,.18);--pcb:#ff7a59"><div class="iconbox"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8l-4 4 4 4"/><path d="M16 8l4 4-4 4"/><path d="M13.5 6l-3 12"/></svg></div><h3>Oprogramowanie na miarę</h3><p>Gdy gotowiec nie wystarcza: aplikacja, panel, płatności, obieg pracy.</p><span class="pmore">Zobacz →</span></a>
      <a class="pillar tilt reveal" href="#automatyzacje" style="--pc:rgba(155,182,255,.18);--pcb:#9bb6ff"><div class="iconbox"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="3"/></svg></div><h3>Automatyzacje</h3><p>Powtarzalna robota, którą ktoś u Ciebie wciąż wykonuje ręcznie.</p><span class="pmore">Zobacz przykłady →</span></a>
    </div>
  </div></section>

  <section id="automatyzacje"><div class="wrap">
    <div class="sec-head reveal"><span class="label">Automatyzacje</span><h2>Powtarzalną robotę da się zdjąć z ludzi</h2><p>Nie mówimy o „AI w firmie". Mówimy o konkretnych czynnościach, które ktoś u Ciebie wykonuje ręcznie co tydzień.</p></div>
    <ul class="feats">
      <li class="reveal"><div class="ftxt"><b>System dokumentów w Google Workspace</b><span>Dokumenty powstają i rozchodzą się same — na Google Workspace i Apps Script.</span></div></li>
      <li class="reveal"><div class="ftxt"><b>Panel Lajf</b><span>Własne narzędzie do analizy danych i obsługi sprzedaży. Używamy go codziennie u siebie.</span></div></li>
      <li class="reveal"><div class="ftxt"><b>Social OS</b><span>Własny system do planowania i prowadzenia komunikacji marek.</span></div></li>
      <li class="reveal"><div class="ftxt"><b>Moje RODO</b><span>System dla placówek medycznych, zbudowany od zera i rozwijany do dziś.</span></div></li>
    </ul>
    <p class="center reveal" style="margin-top:26px;color:var(--mut);max-width:700px;margin-left:auto;margin-right:auto">
      To rozwiązania, które sami zbudowaliśmy — nie przykłady z prezentacji.
    </p>
  </div></section>

  <section id="systemy"><div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Systemy dla firm</span>
      <h2>Gdy arkusz przestaje wystarczać</h2>
      <p>Rdzeń systemu mamy zbudowany, więc nie piszemy go od zera. Składamy z niego narzędzie pod Twój proces, a pierwsza wersja, której da się używać, powstaje w tygodniach.</p>
    </div>
    <ul class="feats">
      {kafelkiSystemow.map((pozycja) => (
        <li class="reveal">
          <span class="ficon"><IkonaSystemu nazwa={pozycja.ikona} /></span>
          <div class="ftxt"><b>{pozycja.naglowek}</b><span>{pozycja.tekst}</span></div>
        </li>
      ))}
    </ul>
    <div class="center" style="margin-top:30px">
      <a href="/oprogramowanie/" class="btn btn-primary magnetic">Zobacz, co jeszcze składamy →</a>
    </div>
  </div></section>

  <section id="audyt"><div class="wrap">
    <div class="sec-head reveal">
      <span class="label">Produkt wejściowy</span>
      <h2>Zacznij od sprawdzenia, co masz</h2>
      <p>Zanim cokolwiek przebudujemy, warto wiedzieć, co naprawdę działa, a co tylko wygląda, że działa.</p>
    </div>
    <div class="abon">
      <div class="reveal">
        <h3 style="font-size:clamp(20px,2.6vw,26px);font-weight:700">Audyt Cyfrowy Placówki lub Firmy</h3>
        <p style="color:var(--mut);margin-top:12px">
          Sprawdzamy, czy cyfrowa strona Twojej firmy rzeczywiście działa tak, jak powinna — od WWW i Google,
          przez analitykę i bezpieczeństwo, po formularze, dane i procesy, które można usprawnić.
          Dostajesz raport z priorytetami, konkretne rekomendacje i omówienie wyników.
        </p>
        <p style="color:var(--mut);margin-top:12px">
          Zaczynamy od <strong style="color:var(--fg)">bezpłatnego pre-audytu</strong> — krótkiego spojrzenia z zewnątrz
          i rozmowy. Dopiero potem decydujesz, czy robimy pełny audyt.
        </p>
      </div>
      <div class="tier featured reveal">
        <div class="tag">Pierwszy krok</div>
        <h3>Audyt Cyfrowy</h3>
        <div class="price">1 490 zł <small>netto</small></div>
        <div class="ab">pre-audyt bezpłatny · bez zobowiązania</div>
        <ul>
          <li>WWW, Google, analityka, bezpieczeństwo</li>
          <li>Formularze, dane i ścieżka klienta</li>
          <li>Procesy, które da się zautomatyzować</li>
          <li>Raport PDF z priorytetami i omówieniem</li>
        </ul>
        <a href="/audyt-placowki-medycznej/" class="btn btn-primary magnetic">Zobacz, co sprawdzamy →</a>
      </div>
    </div>
  </div></section>

  <section id="realizacje"><div class="wrap">
    <div class="sec-head reveal"><span class="label">Realizacje</span><h2>Robota, nie obietnice</h2><p>Dziesięć wdrożeń, dziesięć różnych stylów. Formę dobieramy do marki — nie klepiemy szablonu.</p></div>
    <div class="work">
      {realizacje.map((r) => (
        <a class="frame reveal" href={r.href} {...(r.href.startsWith('/') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}>
          <div class="fbar"><i></i><i></i><i></i><span class="furl">{r.href.startsWith('/') ? 'lajf.eu/realizacje' : r.href.replace('https://', '')}</span></div>
          <img class="fimg" src={r.img} alt={`Realizacja Lajf — ${r.t}`} loading="lazy" width="800" height="500" />
          <div class="fmeta"><div><span class="fm-t">{r.t}</span><span class="fm-d">{r.c}</span></div><span class="ftag">{r.tag}</span></div>
        </a>
      ))}
    </div>
  </div></section>

  {opinie.length > 0 && (
    <section id="opinie"><div class="wrap">
      <div class="sec-head reveal">
        <span class="label">Opinie</span>
        <h2>Co mówią ci, dla których to zrobiłem</h2>
        <p>Każda opinia jest autoryzowana przez klienta. Chcesz zapytać kogoś wprost, jak się z nami pracuje — podamy numer.</p>
      </div>
      <div class="opinie-grid">
        {opinie.map((o) => (
          <figure class="opinia reveal">
            <blockquote>{o.cytat}</blockquote>
            <figcaption><span class="op-kto">{o.kto}</span><span class="op-rola">{o.rola}</span></figcaption>
          </figure>
        ))}
      </div>
    </div></section>
  )}

  <section id="o-mnie"><div class="wrap">
    <div class="founder">
      <div class="founder-photo reveal"><img src="/images/roman.jpg" alt="Roman Jońca — założyciel Lajf" width="1100" height="715" loading="lazy" /></div>
      <div class="founder-text reveal">
        <span class="label">Kto za tym stoi</span>
        <h2>Cześć, jestem Roman.</h2>
        <p>Sprawdzam, jak działa cyfrowa strona firmy, i naprawiam to, co nie działa: stronę, analitykę, bezpieczeństwo, dane i procesy, które da się zautomatyzować. Buduję też własne produkty — dzięki temu wiem, jak te rzeczy wyglądają od środka, a nie tylko z prezentacji.</p>
        <p>Masz jeden kontakt i jedną osobę odpowiedzialną za całość — od pierwszej rozmowy po wdrożenie. A kiedy projekt tego wymaga, za mną stoi sprawdzony zespół. Bez przerzucania Cię między działami, bez znikania po oddaniu pliku.</p>
        <p>Wolę zrobić mniej projektów — ale każdy tak, żebym mógł się pod nim podpisać. Poza tym zajmuję się produkcją muzyczną — to osobna marka, <a href="/muzyka/" style="color:var(--acc)">Dźwięk Dobry</a>.</p>
        <a href="#kontakt" class="btn btn-primary magnetic">Porozmawiajmy →</a>
      </div>
    </div>
    <div class="team-head reveal"><span class="label">Zespół</span><h3>Jeden kontakt — za nim ludzie od każdej działki</h3></div>
    <div class="team">
      <div class="role"><span class="av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg></span><div class="rt"><b>Roman</b><span>Proces, strategia, odpowiedzialność za całość</span></div></div>
      <div class="role"><span class="av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l4 4"/><path d="M4 20l4-1 11-11-3-3L5 16l-1 4z"/></svg></span><div class="rt"><b>Grafik</b><span>Identyfikacja wizualna i design</span></div></div>
      <div class="role"><span class="av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12v18H6z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg></span><div class="rt"><b>Copywriter</b><span>Treść, która sprzedaje</span></div></div>
      <div class="role"><span class="av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8l-4 4 4 4"/><path d="M16 8l4 4-4 4"/><path d="M13.5 6l-3 12"/></svg></span><div class="rt"><b>Programista</b><span>Wdrożenie i kod</span></div></div>
      <div class="role"><span class="av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-5 3 3 6-7"/><path d="M15 8h4v4"/></svg></span><div class="rt"><b>SEO i reklama</b><span>SEO, Google Ads, Meta Ads, GA4</span></div></div>
      <div class="role"><span class="av"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v4h4"/><path d="M9 14l2 2 4-4"/></svg></span><div class="rt"><b>Wsparcie prawne</b><span>RODO, umowy, zgodność</span></div></div>
    </div>
  </div></section>

  <section id="proces"><div class="wrap">
    <div class="sec-head reveal"><span class="label">Ścieżka współpracy</span><h2>Sześć kroków, każdy Twoją decyzją</h2><p>Zaczynamy od czegoś bezpłatnego i niezobowiązującego. Na każdym etapie możesz się zatrzymać.</p></div>
    <div class="steps">
      <div class="step reveal"><div class="n">1</div><h4>Bezpłatny pre-audyt</h4><p>Krótkie sprawdzenie Twojej firmy z zewnątrz. Bez opłaty i bez zobowiązania.</p></div>
      <div class="step reveal"><div class="n">2</div><h4>Rozmowa</h4><p>Mówię wprost, co widzę i czy w ogóle jest o czym rozmawiać. Jeśli nie ma — też to powiem.</p></div>
      <div class="step reveal"><div class="n">3</div><h4>Audyt Cyfrowy</h4><p>Przejście przez siedem obszarów: strona, Google, analityka, bezpieczeństwo, dane, ścieżka klienta, automatyzacje. 1490 zł netto.</p></div>
      <div class="step reveal"><div class="n">4</div><h4>Rekomendacje</h4><p>Raport z priorytetami i konkretnymi zaleceniami, omówiony na rozmowie. Raport jest Twój.</p></div>
      <div class="step reveal"><div class="n">5</div><h4>Wdrożenie</h4><p>Naprawiamy to, co wyszło w audycie. Zakres wynika z raportu. Możesz też zlecić to komu innemu.</p></div>
      <div class="step reveal"><div class="n">6</div><h4>Cyfrowa Opieka <span style="opacity:.6;font-weight:400">— opcjonalnie</span></h4><p>Stała opieka nad cyfrową stroną firmy. Jeśli wolisz dalej sam, to też w porządku.</p></div>
    </div>
    <div class="center reveal" style="margin-top:34px"><a href="/audyt-placowki-medycznej/" class="btn btn-primary magnetic">Zacznij od bezpłatnego pre-audytu →</a></div>
  </div></section>

  <section id="oferta"><div class="wrap">
    <div class="sec-head reveal"><span class="label">Oferta</span><h2>Jawne pakiety. Bez „zapytaj o wycenę".</h2><p>Jeśli już wiesz, czego potrzebujesz — poniżej ceny za konkretne wdrożenia. Jeśli nie wiesz, zacznij od audytu.</p></div>
    <div class="center reveal" style="margin-bottom:38px"><span class="slots"><span class="dot"></span>Przyjmuję ograniczoną liczbę projektów naraz — zapytaj o wolny termin</span></div>
    <div class="abon" style="margin-bottom:38px">
      <div class="reveal">
        <span class="label">Abonament dla usług lokalnych</span>
        <h3 style="font-size:clamp(22px,3vw,30px);font-weight:700;margin-top:8px">Cała obecność w internecie za <span class="hl">399 zł netto/mc</span></h3>
        <p style="color:var(--mut);margin-top:12px">Bez opłaty za wykonanie strony. Strona, domena, serwer, firmowa poczta, analityka GA4 + Cloudflare, Wizytówka Google i całoroczna obsługa — w jednej stałej kwocie. Pierwsza płatność dopiero po akceptacji gotowej strony. <strong>Wizytówki Google, analityki i firmowej poczty nie ma w wersji jednorazowej</strong> — to zostaje w abonamencie, bo wymaga stałego prowadzenia.</p>
