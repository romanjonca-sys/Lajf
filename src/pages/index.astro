---
/**
 * Strona główna lajf.eu od 13.11.2026: jedna oferta (strony WWW w abonamencie) dla polskich firm.
 * Plan i decyzje: mojezycie/plany/2026-11-13-lajf-eu-nowa-glowna-abonament.md.
 * Inne strony linkują tu do kotwic #kontakt, #realizacje i #o-mnie: nie zmieniać tych id.
 */
import Cennik from '../components/glowna/cennik.astro';
import Hero from '../components/glowna/hero.astro';
import Kontakt from '../components/glowna/kontakt.astro';
import Kroki from '../components/glowna/kroki.astro';
import Naglowek from '../components/glowna/naglowek.astro';
import Osoba from '../components/glowna/osoba.astro';
import Porady from '../components/glowna/porady.astro';
import Porownanie from '../components/glowna/porownanie.astro';
import Pytania from '../components/glowna/pytania.astro';
import Realizacje from '../components/glowna/realizacje.astro';
import Stopka from '../components/glowna/stopka.astro';
import GlownaLayout from '../layouts/glowna-layout.astro';

const title = 'Strona WWW dla firmy w abonamencie 399 zł/mc | Lajf';
const description = 'Strona firmowa z treściami, domeną, pocztą i opieką za 399 zł netto/mc. 0 zł na start, płacisz po akceptacji, po 12 ratach strona jest Twoja.';
---
<GlownaLayout title={title} description={description}>
  <Naglowek />
  <main>
    <Hero />
    <Realizacje />
    <Cennik />
    <Kroki />
    <Porownanie />
    <Pytania />
    <Porady />
    <Osoba />
    <Kontakt />
  </main>
  <Stopka />
</GlownaLayout>

<script>
  import '../scripts/glowna';
</script>
