---
import { HERO_SLAJDY } from '../../lib/glowna-tresc';

const [pierwszy] = HERO_SLAJDY;

// Stałe wiersze: w trakcie animacji litery są szersze i bez tego słowa przeskakiwałyby między liniami.
const WIERSZE = [['Strona', 'Twojej'], ['firmy.', 'Zrobiona'], ['i', 'prowadzona'], ['za', 'Ciebie.']];
const SLOWA = WIERSZE.flat();
const FAKTY = [
  ['0 zł', 'na start. Bez opłaty wdrożeniowej.'],
  ['2–4 tyg.', 'od rozmowy do strony gotowej do akceptacji.'],
  ['12 ×', 'rat miesięcznych, dopiero po akceptacji.'],
  ['Twoja', 'po roku: pliki, domena i treści.'],
];
const LITERA_MS = 28;
const NAGLOWEK = `${SLOWA.join(' ')} 399 zł/mc`;
// Numer kolejny litery w całym nagłówku: fala „zaciskania” liter idzie od lewej do prawej.
let n = 0;
const litery = (slowo: string): Array<{ z: string; i: number }> => [...slowo].map((z) => ({ z, i: n++ }));
const wierszeLiter = WIERSZE.map((w) => w.map(litery));
const cena = litery('399');
const zl = litery('zł');
---
<section class="hero"><div class="wrap">
  <h1 class="disp kinetic" id="kinetic" aria-label={NAGLOWEK}>
    {wierszeLiter.map((wiersz) => <span class="line" aria-hidden="true">{wiersz.map((l) => <><span class="w">{l.map(({ z, i }) => <span class="l" style={`--d:${i * LITERA_MS}ms`}>{z}</span>)}</span>{' '}</>)}</span>)}
    <span class="w w-price" aria-hidden="true"><span class="hl" style={`--d:${n * LITERA_MS}ms`}>{cena.map(({ z, i }) => <span class="l" style={`--d:${i * LITERA_MS}ms`}>{z}</span>)} {zl.map(({ z, i }) => <span class="l" style={`--d:${i * LITERA_MS}ms`}>{z}</span>)}<sup>/mc</sup></span></span>
  </h1>
  <script is:inline>
    // Przed pierwszym malowaniem: tekst czeka na kulki (scripts/czastki.ts). Bez ruchu albo canvas zostaje widoczny.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && document.createElement('canvas').getContext) document.getElementById('kinetic').classList.add('czeka');
  </script>
  <div class="hero-sub">
    <div class="ctas">
      <a class="btn btn-signal" href="#kontakt">Poproś o telefon <span class="mono">→</span></a>
      <a class="btn btn-ghost" href="#cena">Zobacz, co w cenie</a>
    </div>
    <p>Piszemy treści, projektujemy stronę, podpinamy domenę i pocztę i pilnujemy, żeby wszystko działało. Nic nie płacisz, dopóki nie zaakceptujesz gotowej strony. Po 12 ratach jest Twoja.</p>
    <span class="note">Odpowiadamy w ciągu dnia roboczego<br /><b>Masz już stronę? Przeniesiemy domenę i pocztę.</b></span>
  </div>
  <div class="devices live done" id="live" data-slajdy={JSON.stringify(HERO_SLAJDY)}>
    <figure class="shot browser">
      <div class="bar mono" id="live-adres">{pierwszy.adres}</div>
      <div class="stage">
        <img id="live-pc" src={pierwszy.komputer} alt="Strony klientów Lajf: widok na komputerze" width="2400" height="1500" fetchpriority="high" />
        <div class="skel" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <figcaption class="status mono"><b></b><span id="status-text">{pierwszy.nazwa} · strona działa</span></figcaption>
    </figure>
    <div class="phone" aria-hidden="true">
      <img id="live-tel" src={pierwszy.telefon} alt="" width="780" height="1688" />
      <div class="toast"><strong>Nowe zapytanie · teraz</strong><span id="live-zapytanie">{pierwszy.zapytanie}</span></div>
    </div>
  </div>
</div></section>
<div class="facts"><div class="wrap"><ul>
  {FAKTY.map(([b, s]) => <li><b class="disp">{b}</b><span>{s}</span></li>)}
</ul></div></div>
