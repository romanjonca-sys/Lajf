---
import { teksty, type Jezyk } from '../../lib/glowna-teksty';

interface Props { jezyk?: Jezyk }
const { jezyk = 'pl' } = Astro.props;
const t = teksty(jezyk);
const [ikona, naglowek, tekst] = t.kartki[0];
---
<section id="o-mnie" class="sec person" aria-labelledby="osoba-h"><div class="wrap grid">
  <div class="txt">
    <h2 id="osoba-h" class="disp">{t.osobaH} <em>{t.osobaEm}</em></h2>
    <p set:html={t.osobaP1} />
    <p>{t.osobaP2}</p>
    <div class="sig mono"><span>{t.osobaSig}</span><span><b>Lajf sp. z o.o.</b> · Jaworzno</span></div>
  </div>
  <figure>
    <img src="/images/glowna/roman-osoba.webp" alt={t.osobaAlt} width="1200" height="675" loading="lazy" />
    <div class="desk" id="desk" aria-hidden="true" data-kartki={JSON.stringify(t.kartki)}><b class="ico">{ikona}</b><strong>{naglowek}</strong><span>{tekst}</span></div>
  </figure>
</div></section>
