---
import { teksty, type Jezyk } from '../../lib/glowna-teksty';

interface Props { jezyk?: Jezyk }
const { jezyk = 'pl' } = Astro.props;
const t = teksty(jezyk);
const [k0, k1, k2] = t.kolumny;
---
<section class="sec" style="padding-top:0"><div class="wrap">
  <div class="head">
    <h2 class="disp">{t.porH}</h2>
    <p>{t.porP}</p>
  </div>
  <div class="compare"><table>
    <thead><tr><th></th><th>{k0}</th><th>{k1}</th><th class="us">{k2}</th></tr></thead>
    <tbody>
      {t.porownanie.map(([c, a, b, l]) => <tr><th scope="row">{c}</th><td data-l={k0}>{a}</td><td data-l={k1}>{b}</td><td class="us" data-l={k2}>{l}</td></tr>)}
    </tbody>
  </table></div>
</div></section>
