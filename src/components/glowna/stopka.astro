---
import { siteConfig } from '../../../site.config';
import { teksty, type Jezyk } from '../../lib/glowna-teksty';
import Logo from './logo.astro';

interface Props { jezyk?: Jezyk }
const { jezyk = 'pl' } = Astro.props;
const t = teksty(jezyk);
const { company } = siteConfig;
---
<footer class="foot"><div class="wrap">
  <div>
    <Logo />
    <p>{company.legalName} · {company.address}<br />{[company.krs && `KRS ${company.krs}`, company.taxId && `NIP ${company.taxId}`, company.regon && `REGON ${company.regon}`].filter(Boolean).join(' · ')}</p>
  </div>
  <div>
    <h4>{t.stopkaRobimy}</h4>
    <ul>{t.stopkaUslugi.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
  </div>
  <div>
    <h4>{t.stopkaFirma}</h4>
    <ul>{t.stopkaFirmaLinki.map(([href, label, kod]) => <li><a href={href} hreflang={kod}>{label}</a></li>)}</ul>
  </div>
</div></footer>
<div class="dock">
  <a class="btn btn-signal" href="#kontakt">{t.ctaRozmowa}</a>
  <a class="btn btn-ghost" href="#cena">{t.dockCena}</a>
</div>
