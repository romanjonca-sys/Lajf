---
import { teksty, type Jezyk } from '../../lib/glowna-teksty';

interface Props { jezyk?: Jezyk }
const { jezyk = 'pl' } = Astro.props;
const t = teksty(jezyk);
---
<section id="jak-to-dziala" class="sec"><div class="wrap">
  <div class="head">
    <h2 class="disp">{t.krokiH}</h2>
    <p>{t.krokiP}</p>
  </div>
  <ol class="steps">
    {t.kroki.map(([h, p, czas], i) => <li><span class="step-n disp" aria-hidden="true">{i + 1}</span><h3>{h}</h3><p>{p}</p><span class="time mono">{czas}</span></li>)}
  </ol>
</div></section>
