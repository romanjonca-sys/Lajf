---
import { teksty, type Jezyk } from '../../lib/glowna-teksty';

interface Props { jezyk?: Jezyk }
const { jezyk = 'pl' } = Astro.props;
const t = teksty(jezyk);
---
<section id="cena" class="sec pricing"><div class="wrap">
  <div class="head">
    <h2 class="disp">{t.cenaH}</h2>
    <p>{t.cenaP}</p>
  </div>
  <div class="plan">
    <div class="plan-l">
      <span class="mono per">{t.miesiecznie}</span>
      <div class="amount disp">{t.kwotaPrzed}<span id="amount">{t.kwota}</span>{t.kwotaPo}<small>{t.kwotaJednostka}</small></div>
      <div class="timeline mono">
        {t.os.map(([etap, opis], i) => <>{i > 0 && <span class="arrow">→</span>}<span>{etap}<b>{opis}</b></span></>)}
      </div>
      <p class="sum" set:html={t.suma} />
    </div>
    <div class="plan-r">
      <ul>{t.wCenie.map((p) => <li>{p}</li>)}</ul>
      <div class="ctas">
        <a class="btn btn-signal" href="#kontakt">{t.ctaTelefon} <span class="mono">→</span></a>
        <a class="btn btn-ghost" href="#pytania">{t.czytajPytania}</a>
      </div>
    </div>
  </div>
  <p class="alt" set:html={t.alt} />
</div></section>
