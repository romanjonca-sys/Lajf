---
/**
 * Analityka z Consent Mode v2 — spięta z banerem `cookie-consent.astro`.
 *
 * Obsługuje DWA warianty, wybierane zmienną środowiskową:
 *   PUBLIC_GTM_ID (np. GTM-XXXXXXX)  → Tag Manager: GA4, Meta Pixel i resztę
 *                                      dodajesz potem klikaniem, bez deployu.
 *   PUBLIC_GA4_ID (np. G-XXXXXXXXXX) → sam GA4, bez pośrednika (lżej o jeden request).
 * Gdy ustawione są obie, wygrywa GTM — inaczej GA4 zliczałby wejścia dwa razy.
 *
 * Zasada wspólna: skrypt ładuje się ZAWSZE, ale startuje ze stanem `denied`
 * (Consent Mode advanced). Bez zgody Google dostaje wyłącznie bezcookie pingi —
 * bez identyfikatorów i bez zapisu na urządzeniu. Pełny pomiar rusza dopiero
 * po `consent update`, wywołanym zdarzeniem `lajf:consent` z banera.
 *
 * Baner trzyma wybór w localStorage pod kluczem `lajf-consent`
 * ('all' = zgoda na analitykę, 'essential' = tylko niezbędne) — czytamy go przy
 * starcie, żeby powracający użytkownik nie musiał klikać drugi raz.
 *
 * Bez żadnej ze zmiennych komponent nie renderuje nic — lokalne uruchomienia
 * i podglądy nie zaśmiecają statystyk.
 */
const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
const gaId = import.meta.env.PUBLIC_GA4_ID ?? '';
const tryb = gtmId ? 'gtm' : gaId ? 'ga4' : 'brak';
---

{tryb !== 'brak' && (
  <script is:inline define:vars={{ gtmId, gaId, tryb }}>
    // Strona używa View Transitions — przy nawigacji Astro potrafi wykonać
    // skrypty z <head> ponownie. Bez tej blokady dublowałyby się nasłuchy zgody
    // i każda odsłona liczyłaby się wielokrotnie.
    if (window.__lajfAnalytics) return;
    window.__lajfAnalytics = true;

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;

    // Consent Mode v2 — MUSI stać przed jakimkolwiek tagiem, inaczej Google
    // przyjmie stan domyślny „granted" i wyśle dane przed decyzją użytkownika.
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500,
    });

    // Czy pierwsza odsłona już poszła. Potrzebne, bo zgoda kliknięta PO wejściu
    // na stronę zastaje odsłonę już wysłaną w trybie `denied` — takie trafienie
    // nie trafia do raportów, więc po zgodzie trzeba je powtórzyć.
    var odslonaWyslana = false;
    var mamyZgode = false;

    function wyslijOdslone() {
      if (tryb !== 'ga4') return;
      gtag('event', 'page_view', {
        page_location: location.href,
        page_title: document.title,
      });
    }

    function zastosujZgode(wartosc) {
      var zgoda = wartosc === 'all' ? 'granted' : 'denied';
      gtag('consent', 'update', {
        analytics_storage: zgoda,
        ad_storage: zgoda,
        ad_user_data: zgoda,
        ad_personalization: zgoda,
      });
      var byloBezZgody = !mamyZgode;
      mamyZgode = zgoda === 'granted';
      if (mamyZgode && byloBezZgody && odslonaWyslana) {
        wyslijOdslone();
      }
    }

    try {
      var zapisana = localStorage.getItem('lajf-consent');
      if (zapisana) {
        zastosujZgode(zapisana);
      }
    } catch (e) {
      // Prywatne okno bez localStorage — zostaje stan domyślny (denied).
    }

    document.addEventListener('lajf:consent', function (event) {
      zastosujZgode(event.detail);
    });

    if (tryb === 'gtm') {
      window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
      var g = document.createElement('script');
      g.async = true;
      g.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
      document.head.appendChild(g);
    } else {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
      document.head.appendChild(s);
      gtag('js', new Date());
      // send_page_view: false — odsłony wysyłamy sami na `astro:page-load`.
      // Automatyczna leci tylko przy pełnym załadowaniu dokumentu, a przy
      // View Transitions kolejne podstrony nie przeładowują dokumentu wcale.
      gtag('config', gaId, { send_page_view: false });
    }

    // Odpala się przy pierwszym wejściu ORAZ po każdej tranzycji między podstronami.
    document.addEventListener('astro:page-load', function () {
      odslonaWyslana = true;
      wyslijOdslone();
    });

    // ——— Pomiar leadów ———
    // `generate_lead` to standardowe zdarzenie GA4 — wystarczy oznaczyć je raz jako
    // kluczowe w panelu. Parametr `method` rozdziela kanały, a page_location (dokładany
    // automatycznie) pokazuje, KTÓRA podstrona przyniosła kontakt.
    function wyslijLead(metoda) {
      gtag('event', 'generate_lead', {
        method: metoda,
        page_location: location.href,
      });
    }

    // Delegacja na document — przetrwa tranzycje i obejmie linki dodane później.
    document.addEventListener('click', function (event) {
      var link = event.target.closest && event.target.closest('a[href^="tel:"], a[href^="mailto:"]');
      if (!link) return;
      wyslijLead(link.getAttribute('href').indexOf('tel:') === 0 ? 'telefon' : 'email');
    });

    // Emitowane przez layout dopiero po udanej odpowiedzi z /api/contact —
    // nieudane próby wysyłki nie są leadem.
    document.addEventListener('lajf:lead', function (event) {
      wyslijLead((event.detail && event.detail.metoda) || 'formularz');
    });
  </script>
)}
