---
/**
 * Google Analytics 4 z Consent Mode v2 — spięty z banerem `cookie-consent.astro`.
 *
 * Zasada: skrypt ładuje się ZAWSZE, ale startuje ze stanem `denied` (Consent Mode
 * advanced). Dopóki użytkownik nie zaakceptuje, Google dostaje wyłącznie bezcookie
 * pingi zgodności — bez identyfikatorów i bez zapisu na urządzeniu. Pełny pomiar
 * rusza dopiero po `consent update`, wywołanym przez zdarzenie `lajf:consent`.
 *
 * Baner zapisuje wybór w localStorage pod kluczem `lajf-consent`
 * ('all' = zgoda na analitykę, 'essential' = tylko niezbędne) — ten sam klucz
 * czytamy przy starcie, żeby powracający użytkownik nie musiał klikać dwa razy.
 *
 * ID w `PUBLIC_GA4_ID` (zmienna środowiskowa) — bez niej komponent nic nie renderuje,
 * więc lokalne uruchomienie i podglądy nie zaśmiecają statystyk.
 */
const gaId = import.meta.env.PUBLIC_GA4_ID ?? '';
---

{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      window.gtag = gtag;

      // Consent Mode v2 — stan domyślny PRZED jakimkolwiek pomiarem.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      function zastosujZgode(wartosc) {
        var zgoda = wartosc === 'all' ? 'granted' : 'denied';
        gtag('consent', 'update', {
          analytics_storage: zgoda,
          ad_storage: zgoda,
          ad_user_data: zgoda,
          ad_personalization: zgoda,
        });
      }

      // Powracający użytkownik: odtwarzamy jego decyzję, zanim padnie page_view.
      try {
        var zapisana = localStorage.getItem('lajf-consent');
        if (zapisana) {
          zastosujZgode(zapisana);
        }
      } catch (e) {
        // Prywatne okno bez localStorage — zostaje stan domyślny (denied).
      }

      document.addEventListener('lajf:consent', function (event) {
        zastosujZgode(event.detail);
      });

      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
