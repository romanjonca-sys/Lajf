---
/**
 * Stopka layoutu Kinetic Aurora: opis firmy, kontakt, kolumny odnośników
 * i linia z danymi rejestrowymi. Wydzielona z `lajf-layout.astro` razem z nawigacją.
 */
import { siteConfig } from '../../site.config';
import { tekstyChrome } from '../lib/chrome-tresci';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { brandName, company } = siteConfig;
const chrome = tekstyChrome(locale);
const year = new Date().getFullYear();

// Kontrahent z innego kraju UE potrzebuje numeru w formacie unijnym (PL + cyfry),
// bo tym weryfikuje podatnika w VIES i rozlicza odwrotne obciążenie.
const numerVat =
  company.taxId && locale === 'en' ? `PL${company.taxId.replace(/\D/g, '')}` : (company.taxId ?? '');
---

<footer><div class="wrap">
  <div class="foot-top">
    <div class="foot-brand">
      <span class="logo">{brandName}<b><svg class="logo-puls" viewBox="45 36 50 33" aria-hidden="true"><path d="M50 54 h5 l5 -14 l6.5 25 l5 -11 h4" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="86" cy="54" r="5.5" fill="currentColor"/></svg></b></span>
      <p>{chrome.stopkaOpis}</p>
      <div class="foot-contact">
        <a href={`mailto:${company.email}`}>{company.email}</a>
        <a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a>
        <span>{chrome.miasto}</span>
      </div>
    </div>
    <div class="foot-cols">
      {chrome.stopkaKolumny.map((kolumna) => (
        <div class="foot-col">
          <h4>{kolumna.naglowek}</h4>
          {kolumna.linki.map((link) => <a href={link.href}>{link.label}</a>)}
          {kolumna.nota && <span>{kolumna.nota}</span>}
        </div>
      ))}
    </div>
  </div>
  <div class="foot-bottom">
    <span>
      © {year} {company.legalName}{company.krs ? ` · ${chrome.rejestr.krs} ${company.krs}` : ''}{company.taxId ? ` · ${chrome.rejestr.nip} ${numerVat}` : ''}{company.regon ? ` · ${chrome.rejestr.regon} ${company.regon}` : ''}
    </span>
    <span>{chrome.stopkaNota}</span>
  </div>
</div></footer>
