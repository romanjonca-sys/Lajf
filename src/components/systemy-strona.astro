---
/**
 * Widok strony o systemach dla firm. Jeden układ dla obu języków, treść z modułu.
 *
 * Powód: polska `/oprogramowanie/` i angielska `/en/systems/` mają pokazywać
 * dokładnie to samo. Gdyby każda miała własny znacznik, pierwsza poprawka trafiłaby
 * tylko do jednej z nich. Tu poprawka idzie w jedno miejsce.
 */
import { trescSystemow } from '../lib/systemy-tresc';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = trescSystemow(locale);
---

<header class="phero"><div class="wrap pin">
  <span class="label">{t.etykietaHero}</span>
  <h1>{t.naglowekHero} <span class="hl">{t.naglowekHeroAkcent}</span></h1>
  <p class="lead">{t.lead}</p>
  <div class="center"><a href={t.hrefKontakt} class="btn btn-primary magnetic">{t.ctaHero}</a></div>
</div></header>

<section id="podejscie"><div class="wrap">
  <div class="sec-head reveal">
    <span class="label">{t.etykietaPodejscie}</span>
    <h2>{t.naglowekPodejscie}</h2>
    <p>{t.wstepPodejscie}</p>
  </div>
  <ul class="feats">
    {t.filaryPodejscia.map((filar) => (
      <li class="reveal">
        <div class="ftxt"><b>{filar.naglowek}</b><span>{filar.tekst}</span></div>
      </li>
    ))}
  </ul>
</div></section>

<section id="katalog"><div class="wrap">
  <div class="sec-head reveal">
    <span class="label">{t.etykietaKatalog}</span>
    <h2>{t.naglowekKatalog}</h2>
    <p>{t.wstepKatalog}</p>
  </div>
  <div class="steps kat">
    {t.katalog.map((pozycja) => (
      <div class="step reveal">
        <h4>{pozycja.naglowek}</h4>
        <p>{pozycja.tekst}</p>
      </div>
    ))}
  </div>
</div></section>

<section id="poziomy"><div class="wrap">
  <div class="sec-head reveal">
    <span class="label">{t.etykietaPoziomy}</span>
    <h2>{t.naglowekPoziomy}</h2>
    <p>{t.wstepPoziomy}</p>
  </div>
  <div class="steps">
    {t.poziomy.map((poziom) => (
      <div class="step reveal">
        <div class="n">{poziom.numer}</div>
        <h4>{poziom.naglowek}</h4>
        <p>{poziom.tekst}</p>
      </div>
    ))}
  </div>
</div></section>

<section id="dowod"><div class="wrap">
  <div class="sec-head reveal">
    <span class="label">{t.etykietaDowod}</span>
    <h2>{t.naglowekDowod}</h2>
    <p>{t.wstepDowod}</p>
  </div>
  <div class="work">
    {t.realizacje.map((r) => (
      <a
        class="w reveal"
        href={r.href}
        {...(r.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <div class="wt">{r.tytul}</div>
        <div class="wc">{r.opis}</div>
        <span class="wtag">{r.tag}</span>
      </a>
    ))}
  </div>
</div></section>

<section><div class="wrap">
  <div class="ctaband reveal">
    <h2>{t.naglowekCta}</h2>
    <p>{t.tekstCta}</p>
    <a href={t.hrefKontakt} class="btn btn-primary magnetic">{t.przyciskCta}</a>
  </div>
</div></section>

<style>
  /* Katalog ma dziewięć pozycji — w siatce silnika (4 kolumny) rozpadłby się
     na 4+4+1. Trzy kolumny dają trzy równe rzędy. */
  @media (min-width: 48rem) { #katalog .kat { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { #katalog .kat { grid-template-columns: repeat(3, 1fr); } }

  /* Poziomy wdrożenia: trzy kroki obok siebie zamiast czterech kolumn z luką. */
  @media (min-width: 64rem) { #poziomy .steps { grid-template-columns: repeat(3, 1fr); } }

  /* Filary podejścia czytają się jak lista argumentów, bez ikon — ikona nic tu
     nie wnosi, a puste miejsce po niej psułoby rytm. */
  #podejscie .feats li { padding-left: 0; }
</style>
