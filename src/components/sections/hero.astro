---
/**
 * Sekcja: hero. Dwa warianty układu wybierane danymi (prop `variant`),
 * NIE kopią komponentu. Dodanie wariantu = nowa gałąź tutaj + opcja w CMS.
 */
import Section from '../primitives/section.astro';
import Button from '../primitives/button.astro';

type HeroVariant = 'image-right' | 'centered-form';

interface Props {
  variant?: HeroVariant;
  title: string;
  subtitle: string;
  ctaLabel: string;
  ctaHref: string;
  imageUrl?: string;
}

const {
  variant = 'image-right',
  title,
  subtitle,
  ctaLabel,
  ctaHref,
  imageUrl,
} = Astro.props;
---

<Section tone="muted">
  <div class:list={['hero', `hero--${variant}`]}>
    <div class="hero__copy">
      <h1 class="hero__title">{title}</h1>
      <p class="hero__subtitle">{subtitle}</p>
      <Button href={ctaHref} label={ctaLabel} tone="primary" />
    </div>

    {variant === 'image-right' && imageUrl && (
      <div class="hero__media">
        <img src={imageUrl} alt="" loading="eager" />
      </div>
    )}

    {variant === 'centered-form' && (
      <form class="hero__form" name="hero-lead" data-engine-form>
        <input type="email" name="email" placeholder="Twój e-mail" required />
        <Button href="#kontakt" label="Wyślij" tone="primary" />
      </form>
    )}
  </div>
</Section>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--space-gap);
    align-items: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -40% -15% auto auto;
    width: 55%;
    aspect-ratio: 1;
    background: var(--gradient-glow);
    pointer-events: none;
    z-index: 0;
  }
  .hero > * {
    position: relative;
    z-index: 1;
  }
  .hero__title {
    font-size: var(--text-hero);
  }
  .hero__subtitle {
    font-size: 1.2rem;
    color: var(--color-text-soft);
    margin-block: 1rem 1.75rem;
    max-width: 38ch;
  }
  .hero--image-right {
    grid-template-columns: 1fr;
  }
  .hero__media img {
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .hero--centered-form {
    text-align: center;
    justify-items: center;
  }
  .hero--centered-form .hero__subtitle {
    margin-inline: auto;
  }
  .hero__form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .hero__form input {
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    min-width: 16rem;
  }
  @media (min-width: 48rem) {
    .hero--image-right {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
