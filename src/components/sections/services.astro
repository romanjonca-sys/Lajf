---
/**
 * Sekcja: usługi. Siatka kart sterowana danymi (`items`).
 */
import Section from '../primitives/section.astro';
import Card from '../primitives/card.astro';
import type { ServiceItem } from '../../lib/content';

interface Props {
  title: string;
  subtitle?: string;
  items: ServiceItem[];
}

const { title, subtitle, items } = Astro.props;
---

<Section id="uslugi">
  <header class="section-head">
    <h2>{title}</h2>
    {subtitle && <p class="section-head__sub">{subtitle}</p>}
  </header>
  <div class="grid">
    {items.map((item) => <Card title={item.title} body={item.body} />)}
  </div>
</Section>

<style>
  .section-head {
    max-width: 46ch;
    margin-bottom: 2.5rem;
  }
  .section-head__sub {
    color: var(--color-text-soft);
    font-size: 1.1rem;
    margin-top: 0.75rem;
  }
  .grid {
    display: grid;
    gap: var(--space-gap);
    grid-template-columns: 1fr;
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
