---
/**
 * Wspólna biblioteka ikon dla kart `.feats` na stronach lajf.eu.
 *
 * Powód istnienia: karty w silniku są zaprojektowane pod ikonę plus krótki tekst.
 * Bez ikony zostaje goły prostokąt z akapitem i sekcja wygląda na niedokończoną.
 * Trzymanie kształtów w jednym pliku pilnuje, żeby wszystkie miały ten sam styl
 * kreski i ten sam viewBox, niezależnie od sekcji, w której się pojawią.
 *
 * Wszystkie: 24×24, tylko obrys, `currentColor`, bez wypełnień. Kolor bierze się
 * z akcentu strony, więc ta sama ikona jest niebieska na stronie głównej
 * i pomarańczowa na `/oprogramowanie/`.
 */

interface Props {
  nazwa: string;
}

const { nazwa } = Astro.props;
---

{nazwa === 'fundament' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3l9 4.5-9 4.5-9-4.5L12 3z" /><path d="M3 12l9 4.5L21 12" /><path d="M3 16.5L12 21l9-4.5" />
  </svg>
)}
{nazwa === 'pola' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 7h16M4 12h16M4 17h16" /><circle cx="9" cy="7" r="2" /><circle cx="15" cy="12" r="2" /><circle cx="8" cy="17" r="2" />
  </svg>
)}
{nazwa === 'rosnie' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 17l5.5-5.5 3.5 3.5L21 6" /><path d="M15 6h6v6" />
  </svg>
)}
{nazwa === 'start' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3v11" /><path d="M8 10l4 4 4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
  </svg>
)}
{nazwa === 'rejestr' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M9 9v11" />
  </svg>
)}
{nazwa === 'obieg' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 12a8 8 0 1 1-2.3-5.6" /><path d="M20 4v4h-4" /><path d="M9 12l2 2 4-4" />
  </svg>
)}
{nazwa === 'portal' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /><path d="M10 17l-5-5 5-5" /><path d="M5 12h9" />
  </svg>
)}
{nazwa === 'kontakty' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="9" cy="8" r="3" /><path d="M3 20a6 6 0 0 1 12 0" /><path d="M16 5.5a3 3 0 0 1 0 5" /><path d="M18 20a5 5 0 0 0-3-4.6" />
  </svg>
)}
{nazwa === 'magazyn' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M3 8l9-4 9 4v9l-9 4-9-4V8z" /><path d="M3 8l9 4 9-4" /><path d="M12 12v9" />
  </svg>
)}
{nazwa === 'zgloszenia' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 6h16v4a2 2 0 0 0 0 4v4H4v-4a2 2 0 0 0 0-4V6z" /><path d="M12 9v3" /><path d="M12 15h.01" />
  </svg>
)}
{nazwa === 'planowanie' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /><path d="M8 14h4" />
  </svg>
)}
{nazwa === 'import' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M6 3h8l5 5v13H6z" /><path d="M14 3v5h5" /><path d="M12 11v6" /><path d="M9.5 14.5L12 17l2.5-2.5" />
  </svg>
)}
{nazwa === 'integracje' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="6" cy="6" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="12" cy="18" r="2.5" />
    <path d="M8.5 6h7" /><path d="M6 8.5v3a2 2 0 0 0 2 2h2.5" /><path d="M18 8.5v3a2 2 0 0 1-2 2h-2.5" />
  </svg>
)}
{nazwa === 'dokumenty' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9 3h6l4 4v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" /><path d="M15 3v4h4" />
    <path d="M4 8v11a2 2 0 0 0 2 2h7" /><path d="M10 12h5M10 15h5" />
  </svg>
)}
{nazwa === 'panel' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 15v-3M12 15V9M17 15v-5" />
  </svg>
)}
{nazwa === 'social' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 9v6h3l5 4V5L7 9H4z" /><path d="M17 8.5a5 5 0 0 1 0 7" /><path d="M19.5 6a8 8 0 0 1 0 12" />
  </svg>
)}
{nazwa === 'tarcza' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3l7 3v5c0 4.6-3.1 7.8-7 9-3.9-1.2-7-4.4-7-9V6l7-3z" /><path d="M9 12l2 2 4-4" />
  </svg>
)}
